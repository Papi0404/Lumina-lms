# ==============================================================================
# LUMINA LMS - Environment Configuration Example (.env.example)
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# --- SMTP OUTGOING EMAIL CONFIGURATION ---
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your_email@example.com
SMTP_PASS=your_16_digit_app_password_here
SMTP_SECURE=tls
SMTP_AUTH_TYPE=LOGIN

# Email Pengirim & Support
MAIL_FROM_ADDRESS=your_email@example.com
SUPPORT_EMAIL=your_email@example.com

# --- AI PROVIDER API KEYS ---
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Opsional)
OPENAI_API_KEY=

# DeepSeek API Key (Opsional)
DEEPSEEK_API_KEY=

# Local Ollama Endpoint (Opsional)
OLLAMA_ENDPOINT=http://localhost:11434

