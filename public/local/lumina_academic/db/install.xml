    <TABLE NAME="lumina_transcripts" COMMENT="Master immutable alumni grade vault resistant to course resets">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="transcript_uuid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="student_nis" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="student_nisn" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="student_name" TYPE="char" LENGTH="150" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="major" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="entry_year" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="2026" SEQUENCE="false"/>
        <FIELD NAME="grad_year" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="2029" SEQUENCE="false"/>
