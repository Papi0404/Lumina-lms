        <FIELD NAME="timefinalized" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="transcript_uuid" UNIQUE="true" FIELDS="transcript_uuid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
