{{!
    Lumina AI — Standalone Academic Tutor Chatbot Template
    Can be loaded by any Moodle theme via hook or direct template include.
}}
<!-- Material Symbols stylesheet to ensure icons render on ANY theme (Boost, Classic, Lumina, etc.) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<!-- Lumina AI Floating Action Button (Compact Circular Pill) -->
<div id="luminaAiFab" class="lumina-ai-fab d-print-none" role="button" aria-label="Tanya Lumina AI" title="Tanya Lumina AI (Academic Tutor)" tabindex="0">
    <div class="ai-fab-glow"></div>
    <div class="ai-fab-content">
        <svg class="ai-fab-logo" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" fill="url(#fab_grad)" opacity="0.2"/>
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="#ffffff"/>
            <circle cx="9.5" cy="11" r="1.5" fill="#38bdf8"/>
            <circle cx="14.5" cy="11" r="1.5" fill="#38bdf8"/>
            <path d="M8.5 15s1.5 2.2 3.5 2.2S15.5 15 15.5 15" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="5" cy="12" r="0.8" fill="#818CF8"/>
            <circle cx="19" cy="12" r="0.8" fill="#818CF8"/>
            <path d="M12 2V0.5M12 23.5V22" stroke="#818CF8" stroke-width="1.2" stroke-linecap="round"/>
            <defs><linearGradient id="fab_grad" x1="2" y1="2" x2="22" y2="22"><stop stop-color="#38bdf8"/><stop offset="1" stop-color="#6366F1"/></linearGradient></defs>
        </svg>
    </div>
</div>

<!-- Lumina AI Floating Chat Window -->
<div id="luminaAiChatWindow" class="lumina-ai-chat-window d-print-none" aria-hidden="true">
    <!-- Chat Header -->
    <div class="ai-chat-header">
        <div class="d-flex align-items-center gap-2">
            <div class="ai-avatar-badge">
                <span class="material-symbols-outlined text-[20px]">psychology</span>
            </div>
            <div>
                <div class="ai-title">{{ chatbot_title }}</div>
                <div class="ai-status">
                    <span class="ai-status-dot"></span>
                    <span>Online • Lumina AI Assistant</span>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button id="luminaAiClearBtn" class="ai-icon-btn" type="button" title="Bersihkan Percakapan" aria-label="Clear chat">
                <span class="material-symbols-outlined text-[18px]">delete_sweep</span>
            </button>
            <button id="luminaAiCloseBtn" class="ai-icon-btn" type="button" title="Tutup Chat" aria-label="Close chat">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>
    </div>

    <!-- Chat Messages Container -->
    <div id="luminaAiMessages" class="ai-chat-messages">
        <!-- Initial Welcome Message -->
        <div class="ai-message ai-message-assistant">
            <div class="ai-msg-avatar">
                <span class="material-symbols-outlined text-[18px]">smart_toy</span>
            </div>
            <div class="ai-msg-body">
                <p class="mb-2">Halo{{#userfirstname}} {{ userfirstname }}{{/userfirstname}}! 👋 Saya <strong>Lumina AI</strong>, asisten akademik personal Anda. Ada materi kuliah, tugas, kuis, atau kodingan yang ingin Anda diskusikan?</p>
                
                <div class="ai-prompt-chips">
                    <button type="button" class="ai-chip" data-prompt="Apa saja daftar mata kuliah saya semester ini?">
                        📘 Daftar mata kuliah
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Apakah ada tugas atau kuis dengan tenggat waktu terdekat?">
                        ⏳ Cek tenggat tugas
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Jelaskan konsep dasar Algoritma Binary Search dan contoh kodenya">
                        🧠 Jelaskan Binary Search
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Jelaskan prinsip ACID dalam Sistem Basis Data">
                        🗄️ Prinsip ACID Basis Data
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Typing Indicator (Hidden by default) -->
    <div id="luminaAiTyping" class="ai-typing-indicator d-none">
        <div class="ai-msg-avatar">
            <span class="material-symbols-outlined text-[18px]">smart_toy</span>
        </div>
        <div class="typing-dots">
            <span></span><span></span><span></span>
        </div>
        <span class="small text-muted ms-2">Lumina AI sedang berpikir...</span>
    </div>

    <!-- Chat Input Area -->
    <div class="ai-chat-footer">
        <form id="luminaAiForm" class="ai-input-form m-0" onsubmit="return false;">
            <div class="ai-input-container">
                <textarea id="luminaAiInput" class="ai-textarea" rows="1" placeholder="Tanyakan apa saja ke Lumina AI... (Enter untuk kirim)" required></textarea>
                <button id="luminaAiSendBtn" class="ai-send-btn" type="button" aria-label="Kirim Pesan">
                    <span class="material-symbols-outlined text-[20px]">send</span>
                </button>
            </div>
            <div class="ai-footer-note">
                Tekan <kbd>Enter</kbd> untuk kirim, <kbd>Shift + Enter</kbd> untuk baris baru
            </div>
        </form>
    </div>
</div>

<style>
/* CSS Force Kill Duplicate Chatbot Elements */
#luminaAiFab ~ #luminaAiFab,
#luminaAiChatWindow ~ #luminaAiChatWindow,
.lumina-ai-fab ~ .lumina-ai-fab,
.lumina-ai-chat-window ~ .lumina-ai-chat-window {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    position: absolute !important;
    pointer-events: none !important;
}

/* Force hide in quiz pages */
body.path-mod-quiz #luminaAiFab,
body.path-mod-quiz #luminaAiChatWindow,
body.path-mod-quiz .lumina-ai-fab,
body.path-mod-quiz .lumina-ai-chat-window {
    display: none !important;
}

/* Force hide in question bank pages */
body.path-question #luminaAiFab,
body.path-question #luminaAiChatWindow,
body.path-question .lumina-ai-fab,
body.path-question .lumina-ai-chat-window {
    display: none !important;
}

/* Force hide in embedded iframes, H5P players, modals, and popups */
body.h5p-embed #luminaAiFab,
body.h5p-embed #luminaAiChatWindow,
body.h5p-embed .lumina-ai-fab,
body.h5p-embed .lumina-ai-chat-window,
body.pagelayout-embedded #luminaAiFab,
body.pagelayout-embedded #luminaAiChatWindow,
body.pagelayout-embedded .lumina-ai-fab,
body.pagelayout-embedded .lumina-ai-chat-window,
body.layout-embedded #luminaAiFab,
body.layout-embedded #luminaAiChatWindow,
body.layout-embedded .lumina-ai-fab,
body.layout-embedded .lumina-ai-chat-window,
body.pagelayout-popup #luminaAiFab,
body.pagelayout-popup #luminaAiChatWindow,
body.pagelayout-popup .lumina-ai-fab,
body.pagelayout-popup .lumina-ai-chat-window {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
}

.lumina-ai-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 54px;
    height: 54px;
    z-index: 99998;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    box-sizing: border-box;
}
.lumina-ai-fab:hover {
    transform: translateY(-3px) scale(1.08);
}
.lumina-ai-fab:active {
    transform: translateY(0) scale(0.95);
}
.ai-fab-glow {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--lumina-ai-primary, #4338ca), #6366f1, #06b6d4);
    filter: blur(8px);
    opacity: 0.65;
    animation: luminaAiPulse 3s infinite ease-in-out;
}
@keyframes luminaAiPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.04); }
}
.ai-fab-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, var(--lumina-ai-primary, #4338ca) 100%);
    color: #ffffff;
    border-radius: 50%;
    box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.5), 0 8px 10px -6px rgba(67, 56, 202, 0.4);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    padding: 0;
    box-sizing: border-box;
}
.ai-fab-logo {
    animation: luminaAiSparkle 2.5s infinite;
}
@keyframes luminaAiSparkle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(10deg) scale(1.1); }
}

/* Chat Window — Self-contained for ANY Moodle theme */
.lumina-ai-chat-window {
    position: fixed;
    bottom: 88px;
    right: 24px;
    width: 400px;
    height: 580px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 110px);
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.25), 0 0 0 1px rgba(226, 232, 240, 0.8);
    display: flex;
    flex-direction: column;
    z-index: 99999;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px) scale(0.96);
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    box-sizing: border-box;
}
.lumina-ai-chat-window * {
    box-sizing: border-box;
}
.lumina-ai-chat-window .d-flex {
    display: flex !important;
}
.lumina-ai-chat-window .align-items-center {
    align-items: center !important;
}
.lumina-ai-chat-window .gap-1 {
    gap: 4px !important;
}
.lumina-ai-chat-window .gap-2 {
    gap: 8px !important;
}
.lumina-ai-chat-window.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
}

@media (max-width: 480px) {
    .lumina-ai-fab {
        bottom: 16px;
        right: 16px;
        width: 48px;
        height: 48px;
    }
    .lumina-ai-chat-window {
        bottom: 72px;
        right: 12px;
        left: 12px;
        width: calc(100vw - 24px);
        max-width: calc(100vw - 24px);
        height: calc(100vh - 90px);
        max-height: calc(100vh - 90px);
    }
}

/* Header */
.ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.ai-avatar-badge {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    border: 1px solid rgba(255, 255, 255, 0.2);
}
.ai-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
}
.ai-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #a5b4fc;
}
.ai-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
}
.ai-icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #c7d2fe;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
}
.ai-icon-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

/* Messages */
.ai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.ai-message {
    display: flex;
    gap: 12px;
    max-width: 90%;
    animation: fadeInAiMsg 0.25s ease-out;
}
@keyframes fadeInAiMsg {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}
.ai-message-user {
    align-self: flex-end;
    flex-direction: row-reverse;
}
.ai-message-assistant {
    align-self: flex-start;
}
.ai-msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--lumina-ai-primary, #4338ca);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.ai-message-user .ai-msg-avatar {
    background: #0ea5e9;
}
.ai-msg-body {
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.55;
    word-break: break-word;
}
.ai-message-assistant .ai-msg-body {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}
.ai-message-user .ai-msg-body {
    background: linear-gradient(135deg, var(--lumina-ai-primary, #4338ca) 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(67, 56, 202, 0.2);
}
.ai-msg-body pre {
    background: #0f172a;
    color: #f8fafc;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.8125rem;
    overflow-x: auto;
    margin: 8px 0;
}
.ai-msg-body code {
    background: rgba(0, 0, 0, 0.06);
    color: #c026d3;
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 0.8125rem;
}
.ai-message-user .ai-msg-body code {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Prompt Chips */
.ai-prompt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}
.ai-chip {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    padding: 5px 11px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}
.ai-chip:hover {
    background: #e0e7ff;
    color: var(--lumina-ai-primary, #4338ca);
    border-color: #a5b4fc;
    transform: translateY(-1px);
}

/* Typing Indicator */
.ai-typing-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px 10px 20px;
    background: #f8fafc;
}
.typing-dots {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}
.typing-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6366f1;
    animation: dotPulse 1.4s infinite ease-in-out both;
}
.typing-dots span:nth-child(1) { animation-delay: -0.32s; }
.typing-dots span:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotPulse {
    0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
}

/* Footer / Input */
.ai-chat-footer {
    padding: 12px 16px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
}
.ai-input-container {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 6px 8px 6px 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.ai-input-container:focus-within {
    border-color: var(--lumina-ai-primary, #4338ca);
    box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.15);
    background: #ffffff;
}
.ai-textarea {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    resize: none;
    max-height: 100px;
    font-size: 0.875rem;
    line-height: 1.4;
    padding: 4px 0;
    font-family: inherit;
    color: #1e293b;
}
.ai-send-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--lumina-ai-primary, #4338ca) 0%, #6366f1 100%);
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, opacity 0.2s;
    flex-shrink: 0;
}
.ai-send-btn:hover {
    transform: scale(1.05);
}
.ai-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}
.ai-footer-note {
    font-size: 0.6875rem;
    color: #94a3b8;
    text-align: center;
    margin-top: 6px;
}
.ai-footer-note kbd {
    background: #e2e8f0;
    color: #475569;
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 0.65rem;
}
</style>

<script>
(function() {
    function initLuminaAi() {
        // 1. CRITICAL: Never run inside an iframe (H5P embed, interactive player, modal dialog)
        if (window.self !== window.top) {
            document.querySelectorAll('#luminaAiFab, #luminaAiChatWindow, .lumina-ai-fab, .lumina-ai-chat-window').forEach(function(el) {
                el.remove();
            });
            return;
        }

        // 2. Skip pages where AI FAB should not appear
        var bodyClasses = document.body.className || '';
        if (/path-mod-quiz|path-question|h5p-embed|pagelayout-embedded|layout-embedded/.test(bodyClasses)) {
            document.querySelectorAll('#luminaAiFab, #luminaAiChatWindow, .lumina-ai-fab, .lumina-ai-chat-window').forEach(function(el) {
                el.remove();
            });
            return;
        }

        document.body.classList.add('has-lumina-ai-plugin');

        // 3. DOM Aggressive Sweeper — remove any duplicate instances
        function removeDuplicates() {
            var fabs = document.querySelectorAll('#luminaAiFab, .lumina-ai-fab');
            var wins = document.querySelectorAll('#luminaAiChatWindow, .lumina-ai-chat-window');
            for (var i = 1; i < fabs.length; i++) fabs[i].remove();
            for (var j = 1; j < wins.length; j++) wins[j].remove();
        }
        removeDuplicates();
        setInterval(removeDuplicates, 1500);

        var fab = document.getElementById('luminaAiFab');

        var win = document.getElementById('luminaAiChatWindow');
        var closeBtn = document.getElementById('luminaAiCloseBtn');
        var clearBtn = document.getElementById('luminaAiClearBtn');
        var input = document.getElementById('luminaAiInput');
        var sendBtn = document.getElementById('luminaAiSendBtn');
        var messagesContainer = document.getElementById('luminaAiMessages');
        var typing = document.getElementById('luminaAiTyping');

        if (!fab || !win || !input || !sendBtn) return;
        if (fab.dataset.initialized) return;
        fab.dataset.initialized = 'true';

        var chatHistory = [];
        var isSending = false;

        // Toggle Chat Window
        function toggleChat(open) {
            if (open === undefined) {
                win.classList.toggle('open');
            } else if (open) {
                win.classList.add('open');
            } else {
                win.classList.remove('open');
            }
            win.setAttribute('aria-hidden', !win.classList.contains('open'));
            if (win.classList.contains('open')) {
                input.focus();
                scrollToBottom();
            }
        }

        fab.addEventListener('click', function() {
            toggleChat(!win.classList.contains('open'));
        });
        closeBtn.addEventListener('click', function() { toggleChat(false); });

        var navAiBtn = document.getElementById('luminaNavAiBtn');
        if (navAiBtn) {
            navAiBtn.addEventListener('click', function(e) {
                e.preventDefault();
                toggleChat(true);
            });
        }

        // Auto-expand textarea
        input.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 100) + 'px';
        });

        // Enter to Send, Shift+Enter for new line
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        sendBtn.addEventListener('click', function() {
            sendMessage();
        });

        // Handle Quick Prompt Chips
        document.addEventListener('click', function(e) {
            var chip = e.target.closest('.ai-chip');
            if (chip && chip.dataset.prompt) {
                input.value = chip.dataset.prompt;
                sendMessage();
            }
        });

        // Clear Chat
        clearBtn.addEventListener('click', function() {
            if (confirm('Bersihkan percakapan dengan Lumina AI?')) {
                chatHistory = [];
                messagesContainer.innerHTML = '';
                appendAssistantMessage('Percakapan telah dibersihkan. Silakan tanyakan materi atau pertanyaan baru!');
            }
        });

        function scrollToBottom() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function formatMarkdown(text) {
            if (!text) return '';
            var escaped = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // Code blocks: ```lang\ncode\n```
            escaped = escaped.replace(/```([a-z0-9_-]*)\n([\s\S]*?)```/gi, function(match, lang, code) {
                return '<pre><code>' + code + '</code></pre>';
            });

            // Inline code: `code`
            escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');

            // Bold: **text**
            escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

            // Bullets: - item
            escaped = escaped.replace(/(?:^|\n)-\s+([^\n]+)/g, '<br>• $1');

            // Numbered list: 1. item
            escaped = escaped.replace(/(?:^|\n)(\d+)\.\s+([^\n]+)/g, '<br>$1. $2');

            // Line breaks
            escaped = escaped.replace(/\n/g, '<br>');

            return escaped;
        }

        function appendUserMessage(text) {
            var div = document.createElement('div');
            div.className = 'ai-message ai-message-user';
            div.innerHTML = 
                '<div class="ai-msg-avatar"><span class="material-symbols-outlined text-[18px]">person</span></div>' +
                '<div class="ai-msg-body">' + formatMarkdown(text) + '</div>';
            messagesContainer.appendChild(div);
            scrollToBottom();
        }

        function appendAssistantMessage(text) {
            var div = document.createElement('div');
            div.className = 'ai-message ai-message-assistant';
            div.innerHTML = 
                '<div class="ai-msg-avatar"><span class="material-symbols-outlined text-[18px]">smart_toy</span></div>' +
                '<div class="ai-msg-body">' + formatMarkdown(text) + '</div>';
            messagesContainer.appendChild(div);
            scrollToBottom();
        }

        function sendMessage() {
            var text = input.value.trim();
            if (!text || isSending) return;

            isSending = true;
            sendBtn.disabled = true;
            input.value = '';
            input.style.height = 'auto';

            appendUserMessage(text);
            chatHistory.push({ role: 'user', text: text });

            // Show typing
            typing.classList.remove('d-none');
            scrollToBottom();

            // Get sesskey
            var sesskey = '{{{ sesskey }}}' || (window.M && window.M.cfg && window.M.cfg.sesskey) || '';
            var postUrl = '{{{ api_endpoint }}}' || ('{{{ wwwroot }}}' + '/local/lumina_ai/ai_chat.php');

            var formData = new URLSearchParams();
            formData.append('message', text);
            formData.append('sesskey', sesskey);
            formData.append('history', JSON.stringify(chatHistory.slice(-8)));

            fetch(postUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            })
            .then(function(res) {
                return res.json();
            })
            .then(function(data) {
                typing.classList.add('d-none');
                isSending = false;
                sendBtn.disabled = false;

                if (data && data.reply) {
                    appendAssistantMessage(data.reply);
                    chatHistory.push({ role: 'model', text: data.reply });
                } else {
                    appendAssistantMessage('Maaf, saya sedang mengalami kendala teknis saat memproses respons. Silakan coba lagi.');
                }
            })
            .catch(function(err) {
                typing.classList.add('d-none');
                isSending = false;
                sendBtn.disabled = false;
                appendAssistantMessage('Koneksi terputus atau sesi telah berakhir. Silakan muat ulang halaman atau coba beberapa saat lagi.');
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLuminaAi);
    } else {
        initLuminaAi();
    }
})();
</script>
