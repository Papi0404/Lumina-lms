<script>
document.addEventListener('DOMContentLoaded', function() {
    // Rail toggle handler
    const railToggle = document.getElementById('luminaRailToggle');
    if (railToggle) {
        railToggle.addEventListener('click', function() {
            document.body.classList.toggle('lumina-rail-collapsed');
            const isCollapsed = document.body.classList.contains('lumina-rail-collapsed');
            if (window.M && window.M.util && window.M.util.set_user_preference) {
                M.util.set_user_preference('lumina-rail-collapsed', isCollapsed ? 1 : 0);
            }
        });
    }

    // Mobile sidebar and overlay toggle handler
    const mobileToggle = document.getElementById('luminaMobileToggle');
    const sidebar = document.getElementById('luminaSidebar');
    const overlay = document.getElementById('luminaMobileOverlay');
    if (mobileToggle && sidebar) {
        mobileToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            sidebar.classList.toggle('mobile-open');
            if (overlay) overlay.classList.toggle('show');
        });

        if (overlay) {
            overlay.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('show');
            });
        }

        document.addEventListener('click', function(e) {
            if (!sidebar.contains(e.target) && !mobileToggle.contains(e.target)) {
                sidebar.classList.remove('mobile-open');
                if (overlay) overlay.classList.remove('show');
            }
        });
    }

    // Keyboard shortcut for Cmd+K search
    document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            const searchInput = document.querySelector('.lumina-search-input');
            if (searchInput && document.activeElement !== searchInput) {
                e.preventDefault();
                searchInput.focus();
                searchInput.select();
            }
        }
    });
    // Show security alert banner unless dismissed in this session
    const secBanner = document.getElementById('luminaSecurityBanner');
    if (secBanner && !sessionStorage.getItem('lumina_sec_dismissed')) {
        secBanner.style.display = 'block';
    }

    // Course Management Form Guard (Prevent "A required parameter movecategoriesto / resortcategoriesby was missing")
    const mgmtForm = document.getElementById('coursecat-management');
    if (mgmtForm) {
        // Universal guard on submit: ensure all form controls inside #coursecat-management
        // are enabled right before submit so the browser includes them in the POST payload.
        mgmtForm.addEventListener('submit', function() {
            mgmtForm.querySelectorAll('select[disabled], input[disabled]').forEach(function(el) {
                el.removeAttribute('disabled');
            });
        });

        // Guard 1: Move Categories (bulkmovecategories)
        const moveCatBtn = mgmtForm.querySelector('input[name="bulkmovecategories"]');
        const moveCatSelect = mgmtForm.querySelector('select[name="movecategoriesto"]');
        if (moveCatBtn && moveCatSelect) {
            moveCatBtn.addEventListener('click', function(e) {
                const checkedCats = mgmtForm.querySelectorAll('input[name="bcat[]"]:checked');
                if (checkedCats.length === 0) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    alert('Harap centang minimal satu kategori yang ingin dipindahkan.');
                    return false;
                }
                // '0' represents 'Top' category, so only empty string is invalid
                if (moveCatSelect.value === '' || moveCatSelect.value === null || moveCatSelect.value === undefined) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    moveCatSelect.focus();
                    moveCatSelect.style.borderColor = '#EF4444';
                    moveCatSelect.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.2)';
                    alert('Harap pilih kategori tujuan pemindahan terlebih dahulu pada menu dropdown.');
                    return false;
                }
                moveCatSelect.removeAttribute('disabled');
                moveCatSelect.style.borderColor = '';
                moveCatSelect.style.boxShadow = '';
            });
        }

        // Guard 2: Move Courses (bulkmovecourses)
        const moveCourseBtn = mgmtForm.querySelector('input[name="bulkmovecourses"]');
        const moveCourseSelect = mgmtForm.querySelector('select[name="movecoursesto"]');
        if (moveCourseBtn && moveCourseSelect) {
            moveCourseBtn.addEventListener('click', function(e) {
                const checkedCourses = mgmtForm.querySelectorAll('input[name="bc[]"]:checked');
                if (checkedCourses.length === 0) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    alert('Harap centang minimal satu mata kuliah yang ingin dipindahkan.');
                    return false;
                }
                if (moveCourseSelect.value === '' || moveCourseSelect.value === null || moveCourseSelect.value === undefined) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    moveCourseSelect.focus();
                    moveCourseSelect.style.borderColor = '#EF4444';
                    moveCourseSelect.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.2)';
                    alert('Harap pilih kategori tujuan pemindahan kursus terlebih dahulu pada menu dropdown.');
                    return false;
                }
                moveCourseSelect.removeAttribute('disabled');
                moveCourseSelect.style.borderColor = '';
                moveCourseSelect.style.boxShadow = '';
            });
        }

        // Guard 3: Sort Categories & Courses (bulksort)
        const sortBtn = mgmtForm.querySelector('input[name="bulksort"]');
        const sortCatSelect = mgmtForm.querySelector('select[name="resortcategoriesby"]');
        const sortCourseSelect = mgmtForm.querySelector('select[name="resortcoursesby"]');
        const selectSortBy = mgmtForm.querySelector('select[name="selectsortby"]');
        if (sortBtn) {
            sortBtn.addEventListener('click', function(e) {
                if (selectSortBy && selectSortBy.value === 'selectedcategories') {
                    const checkedCats = mgmtForm.querySelectorAll('input[name="bcat[]"]:checked');
                    if (checkedCats.length === 0) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        alert('Harap centang minimal satu kategori yang ingin diurutkan, atau pilih opsi "All categories" / "Semua kategori".');
                        return false;
                    }
                }
                // Ensure dropdowns are enabled so the browser transmits their values in POST
                if (selectSortBy) selectSortBy.removeAttribute('disabled');
                if (sortCatSelect) {
                    sortCatSelect.removeAttribute('disabled');
                    if (!sortCatSelect.value) sortCatSelect.value = 'name';
                }
                if (sortCourseSelect) {
                    sortCourseSelect.removeAttribute('disabled');
                    if (!sortCourseSelect.value) sortCourseSelect.value = 'fullname';
                }
            });
        }
    }

    // Teacher: Auto-trigger Activity/Resource Chooser when clicking "Buat Materi/Modul" (add_material=1)
    if (window.location.search.indexOf('add_material=1') !== -1) {
        const courseRegion = document.getElementById('region-main') || document.querySelector('.course-content');
        if (courseRegion && !document.getElementById('lumina-add-material-banner')) {
            const banner = document.createElement('div');
            banner.id = 'lumina-add-material-banner';
            banner.className = 'alert d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 border-0 shadow-sm';
            banner.style.cssText = 'background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); border-left: 5px solid #4338CA !important;';
            banner.innerHTML = `
                <div class="d-flex align-items-center gap-3">
                    <span class="material-symbols-outlined fs-2" style="color: #4338CA;">post_add</span>
                    <div>
                        <h6 class="mb-0 fw-bold" style="color: #312E81;">Mode Buat Materi & Modul Aktif</h6>
                        <p class="mb-0 small" style="color: #4B5563;">Pilih modul (Berkas PDF/PPT, Tugas, Kuis, Halaman Materi, URL, dll.) dari jendela pemilih aktivitas atau klik tombol <em>+ Add content</em> di topik yang diinginkan.</p>
                    </div>
                </div>
                <button type="button" class="btn btn-sm text-white rounded-pill px-3 py-2 fw-semibold shadow-xs" id="lumina-open-chooser-action" style="background: #4338CA; border: none; cursor: pointer;">
                    + Buka Menu Modul
                </button>
            `;
            courseRegion.prepend(banner);

            const triggerBtn = document.getElementById('lumina-open-chooser-action');
            if (triggerBtn) {
                triggerBtn.addEventListener('click', function() {
                    const btn = document.querySelector('button[data-action="open-chooser"]') ||
                                document.querySelector('.section-modchooser-link') ||
                                document.querySelector('.activity-add');
                    if (btn) {
                        btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        btn.click();
                    }
                });
            }
        }

        // Automatically trigger the first chooser modal after content is ready
        let attempts = 0;
        const autoOpenInterval = setInterval(function() {
            attempts++;
            const chooserBtn = document.querySelector('button[data-action="open-chooser"]') ||
                               document.querySelector('.section-modchooser-link') ||
                               document.querySelector('.activity-add');
            if (chooserBtn) {
                clearInterval(autoOpenInterval);
                setTimeout(function() {
                    chooserBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    chooserBtn.click();
                }, 400);
            }
            if (attempts > 25) {
                clearInterval(autoOpenInterval);
            }
        }, 200);
    }
});
</script>

