{{!
    Lumina LMS Master Drawers Layout Template.
}}
{{> theme_lumina/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    <!-- Lumina Left Navigation Rail -->
    {{> theme_lumina/nav-rail }}

    <!-- Mobile Overlay Backdrop -->
    <div id="luminaMobileOverlay" class="lumina-mobile-overlay" aria-hidden="true"></div>

    <!-- Lumina Fixed Top Navigation Bar -->
    {{> theme_lumina/navbar }}

    <!-- Course Index Drawer (when inside course) -->
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheading}}{{> theme_boost/courseindexdrawerheading}}{{/drawerheading}}
            {{$drawercontrols}}{{> theme_boost/courseindexdrawercontrols}}{{/drawercontrols}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}

    <!-- Side Blocks Drawer (when blocks exist) -->
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers lumina-main-viewport {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-courseindex"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerindex, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>

            <!-- Lumina Dynamic Dashboard Container by Role -->
            {{#lumina_nav.is_dashboard}}

            <!-- ================================================================= -->
            <!-- 1. ADMINISTRATOR DASHBOARD VIEW                                   -->
            <!-- ================================================================= -->
            {{#lumina_role.is_admin}}
            <div class="lumina-dashboard-view role-admin d-print-none">
                <!-- Admin Hero Banner -->
                <div class="lumina-welcome-banner admin-banner mb-4">
                    <div class="row align-items-center justify-content-between g-4">
                        <div class="col-xl-8 col-lg-7">
                            <div class="banner-semester-pill admin-pill">
                                <span class="pulse-dot green"></span>
                                <span>STATUS SISTEM: {{ lumina_admin.system_status }} • MOODLE v{{ lumina_admin.moodle_version }}</span>
                            </div>
                            <h1 class="banner-title">Dasbor Administrator, {{ lumina_user.fullname }}! ⚡</h1>
                            <p class="banner-subtitle">Pantau kesehatan infrastruktur server, aktivitas akun pengguna, log keamanan, dan manajemen kursus global secara terpadu.</p>
                        </div>
                        <div class="col-xl-4 col-lg-5 text-lg-end">
                            <div class="d-inline-flex gap-2 flex-wrap">
                                <a href="{{{ config.wwwroot }}}/admin/user.php" class="btn btn-sm btn-light rounded-pill px-3 py-2 fw-semibold shadow-xs">
                                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: text-bottom;">group_add</span>
                                    Kelola Pengguna
                                </a>
                                <a href="{{{ config.wwwroot }}}/course/management.php" class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-semibold shadow-xs">
                                    <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: text-bottom;">add_circle</span>
                                    Buat Kursus Baru
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Anti-Gravity KPI Glass Cards (Admin) -->
                <div class="lumina-antigravity-kpi-grid mb-4">
                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble indigo">
                            <span class="material-symbols-outlined">supervisor_account</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Total Pengguna Terdaftar</span>
                            <h3 class="stat-value">{{ lumina_admin.total_users }} <span class="stat-subbadge">{{ lumina_admin.active_users_5m }} Online</span></h3>
                            <span class="stat-caption">{{ lumina_admin.active_users_24h }} pengguna aktif 24 jam terakhir</span>
                        </div>
                    </div>

                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble cyan">
                            <span class="material-symbols-outlined">dns</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Infrastruktur Server</span>
                            <h3 class="stat-value">PHP {{ lumina_admin.php_version }}</h3>
                            <span class="stat-caption">Database: {{ lumina_admin.db_type }} &bull; RAM: {{ lumina_admin.memory_usage }}</span>
                        </div>
                    </div>

                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble emerald">
                            <span class="material-symbols-outlined">verified_user</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Skor Keamanan Sistem</span>
                            <h3 class="stat-value">{{ lumina_admin.security_score }}% <span class="stat-subbadge optimal">Aman</span></h3>
                            <span class="stat-caption">Protokol SSL &amp; isolasi modul aktif</span>
                        </div>
                    </div>

                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble amber">
                            <span class="material-symbols-outlined">auto_stories</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Total Kursus Global</span>
                            <h3 class="stat-value">{{ lumina_admin.total_courses }} <span class="stat-subbadge">Aktif</span></h3>
                            <span class="stat-caption">Semua fakultas &amp; program studi</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Administrative Shortcut Panels -->
                <div class="antigravity-glass-card rounded-3xl p-4 mb-4">
                    <div class="section-card-header mb-3">
                        <span class="section-title fw-bold">Pusat Kendali Administrasi</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1">Role: Administrator</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/admin/user.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-primary">manage_accounts</span>
                                <span class="tile-title">Manajemen Akun</span>
                                <span class="tile-desc">Tambah, edit, atau daftarkan user</span>
                            </a>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/course/management.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-indigo">menu_book</span>
                                <span class="tile-title">Manajemen Course</span>
                                <span class="tile-desc">Buat kursus, kategori, &amp; assign guru</span>
                            </a>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/local/lumina_core/exam_review.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-danger">verified_user</span>
                                <span class="tile-title">Audit Ujian Anti-Curang</span>
                                <span class="tile-desc">Tinjau sesi ujian yang ditangguhkan</span>
                            </a>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/local/lumina_core/library.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-warning">folder_special</span>
                                <span class="tile-title">Perpustakaan Digital</span>
                                <span class="tile-desc">Kelola folder, berkas, &amp; H5P global</span>
                            </a>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/admin/search.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-success">admin_panel_settings</span>
                                <span class="tile-title">Site Administration</span>
                                <span class="tile-desc">Pusat konfigurasi Moodle</span>
                            </a>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <a href="{{{ config.wwwroot }}}/report/security/index.php" class="antigravity-action-tile">
                                <span class="material-symbols-outlined tile-icon text-secondary">shield_lock</span>
                                <span class="tile-title">Log Keamanan</span>
                                <span class="tile-desc">Audit riwayat login &amp; akses</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {{/lumina_role.is_admin}}

            <!-- ================================================================= -->
            <!-- 2. GURU / INSTRUKTUR DASHBOARD VIEW                               -->
            <!-- ================================================================= -->
            {{#lumina_role.is_teacher}}
            <div class="lumina-dashboard-view role-teacher d-print-none">
                <!-- Teacher Hero Banner -->
                <div class="lumina-welcome-banner teacher-banner mb-4">
                    <div class="row align-items-center justify-content-between g-4">
                        <div class="col-xl-8 col-lg-7">
                            <div class="banner-semester-pill teacher-pill">
                                <span class="pulse-dot amber"></span>
                                <span>PORTAL PENGAJAR • {{ lumina_semester }}</span>
                            </div>
                            <h1 class="banner-title">Selamat Bertugas, {{ lumina_user.fullname }}! 📚</h1>
                            <p class="banner-subtitle">
                                {{#lumina_teacher.pending_grading_count}}
                                Terdapat <strong class="text-warning font-bold">{{ lumina_teacher.pending_grading_count }} berkas tugas</strong> yang siap dinilai.
                                {{/lumina_teacher.pending_grading_count}}
                                {{^lumina_teacher.pending_grading_count}}
                                Semua berkas tugas mahasiswa sudah dinilai tuntas. Kelas Anda dalam kondisi optimal!
                                {{/lumina_teacher.pending_grading_count}}
                            </p>
                        </div>
                        <div class="col-xl-4 col-lg-5 text-lg-end">
                            <a href="{{{ lumina_nav.teacher_manage_material_url }}}" class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-semibold shadow-xs">
                                <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: text-bottom;">post_add</span>
                                Kelola &amp; Tambah Materi
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Anti-Gravity KPI Glass Cards (Teacher) -->
                <div class="lumina-antigravity-kpi-grid mb-4">
                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble amber">
                            <span class="material-symbols-outlined">assignment_late</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Menunggu Penilaian</span>
                            <h3 class="stat-value">{{ lumina_teacher.pending_grading_count }} <span class="stat-subbadge urgent">Berkas</span></h3>
                            <span class="stat-caption">Perlu review &amp; umpan balik dosen</span>
                        </div>
                    </div>

                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble indigo">
                            <span class="material-symbols-outlined">groups</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Total Siswa Bimbingan</span>
                            <h3 class="stat-value">{{ lumina_teacher.total_students_guided }} <span class="stat-subbadge">Mahasiswa</span></h3>
                            <span class="stat-caption">Terdaftar di seluruh kelas Anda</span>
                        </div>
                    </div>

                    <div class="antigravity-glass-card stat-card float-hover">
                        <div class="stat-icon-bubble emerald">
                            <span class="material-symbols-outlined">menu_book</span>
                        </div>
                        <div class="stat-details">
                            <span class="stat-label">Kelas / Kursus Diampu</span>
                            <h3 class="stat-value">{{ lumina_teacher.courses_count }} <span class="stat-subbadge optimal">Aktif</span></h3>
                            <span class="stat-caption">Semester berjalan 2026/2027</span>
                        </div>
                    </div>
                </div>

                <!-- Daftar Kelas & Kehadiran Siswa Panel -->
                <div id="daftar-kelas" class="antigravity-glass-card rounded-3xl p-4 mb-4">
                    <div class="section-card-header mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-primary" style="font-size: 24px;">groups</span>
                            <span class="section-title fw-bold">Daftar Kelas &amp; Kehadiran Siswa</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 ms-2 rounded-pill px-2 py-0-5 font-semibold" style="font-size: 0.72rem;">Kelas yang Anda Ampu</span>
                        </div>
                        <span class="text-muted small">Total: <strong>{{ lumina_teacher.courses_count }}</strong> Kelas</span>
                    </div>

                    {{#lumina_teacher.has_courses}}
                    <div class="row g-3">
                        {{#lumina_teacher.courses}}
                        <div class="col-md-6 col-lg-4">
                            <div class="antigravity-action-tile h-100 p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-primary bg-opacity-10 text-primary border rounded-pill px-2 py-0-5 font-semibold" style="font-size: 0.7rem;">{{ shortname }}</span>
                                        <span class="text-muted small d-inline-flex align-items-center gap-1">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">person</span>
                                            <strong>{{ students_count }}</strong> Siswa
                                        </span>
                                    </div>
                                    <h5 class="tile-title mb-1" style="font-size: 1rem;">{{ fullname }}</h5>
                                    <p class="tile-desc mb-3">Lihat presensi kehadiran, riwayat keaktifan siswa, dan buku nilai.</p>
                                </div>
                                <div class="d-flex gap-2 flex-wrap pt-2 border-top">
                                    <a href="{{{ attendance_url }}}" class="btn btn-sm btn-primary rounded-pill px-3 py-1-5 flex-fill text-center d-inline-flex align-items-center justify-content-center gap-1 shadow-xs" title="Buka Presensi Kehadiran Kelas">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">how_to_reg</span>
                                        <span>Presensi Kelas</span>
                                    </a>
                                    <a href="{{{ edit_url }}}" class="btn btn-sm btn-outline-secondary rounded-pill px-2-5 py-1-5 d-inline-flex align-items-center justify-content-center" title="Kelola Materi Modul">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">post_add</span>
                                    </a>
                                    <a href="{{{ grader_url }}}" class="btn btn-sm btn-outline-secondary rounded-pill px-2-5 py-1-5 d-inline-flex align-items-center justify-content-center" title="Buku Nilai">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">grade</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        {{/lumina_teacher.courses}}
                    </div>
                    {{/lumina_teacher.has_courses}}

                    {{^lumina_teacher.has_courses}}
                    <div class="empty-state-box text-center py-4">
                        <span class="material-symbols-outlined text-muted" style="font-size: 42px;">school</span>
                        <h6 class="mt-2 mb-1 fw-bold">Belum Ada Kelas yang Ditugaskan</h6>
                        <p class="text-muted small mb-0">Sesuai alur sekolah, Administrator yang membuat kursus dan menugaskan guru pengampu. Hubungi Admin untuk ditugaskan ke kelas Anda.</p>
                    </div>
                    {{/lumina_teacher.has_courses}}
                </div>

                <!-- Main 2-Column Responsive Layout for Teacher -->
                <div class="row g-4 mb-4">
                    <!-- Left: Pending Grading Queue -->
                    <div class="col-lg-8">
                        <div class="antigravity-glass-card rounded-3xl p-4 h-100">
                            <div class="section-card-header mb-3">
                                <div>
                                    <span class="section-title fw-bold">Antrean Tugas Perlu Dinilai</span>
                                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 ms-2 rounded-pill px-2 py-0-5 font-semibold" style="font-size: 0.72rem;">Pending Grading</span>
                                </div>
                                <a href="{{{ lumina_nav.grades_url }}}" class="section-link">Buka Buku Nilai →</a>
                            </div>

                            <div class="teacher-grading-queue">
                                {{#lumina_teacher.pending_submissions}}
                                <div class="queue-item-card">
                                    <div class="queue-student-info">
                                        <div class="queue-avatar-placeholder">
                                            <span class="material-symbols-outlined">person</span>
                                        </div>
                                        <div>
                                            <h6 class="student-name mb-0">{{ student_name }}</h6>
                                            <span class="assignment-meta">{{ course_name }} &bull; {{ assignment_name }}</span>
                                        </div>
                                    </div>
                                    <div class="queue-actions">
                                        <span class="submission-time text-muted"><i class="fa-regular fa-clock me-1"></i>{{ submitted_ago }}</span>
                                        <a href="{{{ grade_url }}}" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">Beri Nilai</a>
                                    </div>
                                </div>
                                {{/lumina_teacher.pending_submissions}}

                                {{^lumina_teacher.has_pending_grading}}
                                <div class="empty-state-box text-center py-5">
                                    <span class="material-symbols-outlined text-success" style="font-size: 48px;">task_alt</span>
                                    <h5 class="mt-2 mb-1 fw-bold">Semua Tugas Sudah Dinilai!</h5>
                                    <p class="text-muted small">Tidak ada berkas tugas mahasiswa yang sedang menunggu penilaian saat ini.</p>
                                </div>
                                {{/lumina_teacher.has_pending_grading}}
                            </div>
                        </div>
                    </div>

                    <!-- Right: Today's Schedule & Quick Tools -->
                    <div class="col-lg-4">
                        <div class="antigravity-glass-card rounded-3xl p-4 h-100">
                            <div class="section-card-header mb-3">
                                <span class="section-title fw-bold">Jadwal Mengajar Hari Ini</span>
                            </div>

                            <div class="teacher-schedule-list">
                                {{#lumina_teacher.today_schedule}}
                                <div class="schedule-timeline-item {{#is_live}}live{{/is_live}}">
                                    <div class="schedule-time-badge">{{ time_str }}</div>
                                    <div class="schedule-body">
                                        <h6 class="schedule-title mb-1">{{ title }}</h6>
                                        {{#is_live}}<span class="live-status-pill">SEDANG BERLANGSUNG</span>{{/is_live}}
                                    </div>
                                </div>
                                {{/lumina_teacher.today_schedule}}

                                {{^lumina_teacher.has_today_schedule}}
                                <div class="empty-state-box text-center py-4">
                                    <span class="material-symbols-outlined text-muted" style="font-size: 36px;">event_available</span>
                                    <p class="text-muted small mt-2 mb-0">Tidak ada sesi mengajar langsung terjadwal hari ini.</p>
                                </div>
                                {{/lumina_teacher.has_today_schedule}}
                            </div>

                            <div class="teacher-quick-tools mt-4 pt-3 border-top">
                                <h6 class="small fw-bold text-muted text-uppercase mb-2">Akses Cepat</h6>
                                <div class="d-grid gap-2">
                                    <a href="{{{ lumina_nav.virtualclass_url }}}" class="btn btn-sm btn-light border text-start rounded-pill px-3 py-2 d-flex align-items-center gap-2">
                                        <span class="material-symbols-outlined text-primary" style="font-size: 18px;">videocam</span>
                                        <span>Buka Kelas Virtual</span>
                                    </a>
                                    <a href="{{{ lumina_nav.forum_url }}}" class="btn btn-sm btn-light border text-start rounded-pill px-3 py-2 d-flex align-items-center gap-2">
                                        <span class="material-symbols-outlined text-indigo" style="font-size: 18px;">chat</span>
                                        <span>Forum Diskusi Kelas</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/lumina_role.is_teacher}}

            <!-- ================================================================= -->
            <!-- 3. MURID / SISWA DASHBOARD VIEW                                   -->
            <!-- ================================================================= -->
            {{#lumina_role.is_student}}
            <div class="lumina-dashboard-view role-student d-print-none">
                <!-- Lumina Hero Banner on Dashboard -->
                <div class="lumina-welcome-banner d-print-none mb-4">
                    <div class="row align-items-center justify-content-between g-4">
                        <div class="col-xl-8 col-lg-7">
