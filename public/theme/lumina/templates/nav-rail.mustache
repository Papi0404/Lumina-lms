                    <span class="brand-title">{{ sitename }}</span>
                    <span class="brand-version">v5.3 Lumina LMS</span>
                </div>
            </a>
            <button class="rail-toggle-btn d-none d-lg-flex" id="luminaRailToggle" type="button" aria-label="Toggle Navigation Rail">
                <span class="material-symbols-outlined text-[20px]">keyboard_double_arrow_left</span>
