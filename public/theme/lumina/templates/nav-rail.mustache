                            <span class="material-symbols-outlined nav-icon">calendar_month</span>
                            <span>{{#str}}calendar_deadlines, theme_lumina{{/str}}</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="{{{ lumina_nav.grades_url }}}" class="nav-link-item {{#lumina_nav.is_grades}}active{{/lumina_nav.is_grades}}">
