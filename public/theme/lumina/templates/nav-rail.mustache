                            <span class="material-symbols-outlined nav-icon">school</span>
                            <span>{{#str}}mycourses, theme_lumina{{/str}}</span>
                        </div>
                        {{#lumina_user.enrolled_count}}
                        <span class="nav-count-badge">{{ lumina_user.enrolled_count }} Aktif</span>
                        {{/lumina_user.enrolled_count}}
                    </a>
                </li>
                <li>
                    <a href="{{{ config.wwwroot }}}/calendar/view.php" class="nav-link-item {{#lumina_nav.is_calendar}}active{{/lumina_nav.is_calendar}}">
