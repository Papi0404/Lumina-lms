                            <span>{{#str}}grades_analytics, theme_lumina{{/str}}</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-nav-section">
            <div class="nav-section-title">{{#str}}collaboration_nav, theme_lumina{{/str}}</div>
            <ul class="nav-list">
                <li>
                    <a href="{{{ lumina_nav.forum_url }}}" class="nav-link-item {{#lumina_nav.is_forum}}active{{/lumina_nav.is_forum}}">
