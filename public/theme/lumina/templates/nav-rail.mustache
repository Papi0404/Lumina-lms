                                    <path d="M9 11.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5S11.33 13 10.5 13 9 12.33 9 11.5zM13.5 10c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z" fill="#6366F1"/>
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="#6366F1"/>
                                    <path d="M8.5 15.5s1.5 2 3.5 2 3.5-2 3.5-2" stroke="#6366F1" stroke-width="1.5" stroke-linecap="round"/>
                                    <circle cx="5" cy="12" r="1" fill="#818CF8"/>
                                    <circle cx="19" cy="12" r="1" fill="#818CF8"/>
                                    <path d="M12 2V0M12 24v-2" stroke="#818CF8" stroke-width="1.5" stroke-linecap="round"/>
