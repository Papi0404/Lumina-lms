    <div class="sidebar-footer">
        <div class="cloud-storage-card">
            <div class="storage-header">
                <span class="storage-title">{{#str}}cloud_storage, theme_lumina{{/str}}</span>
                <span class="storage-percent">{{ lumina_storage.percent }}%</span>
            </div>
            <div class="storage-progress">
                <div class="progress-bar-fill" style="width: {{ lumina_storage.percent }}%;"></div>
            </div>
            <div class="storage-meta">{{ lumina_storage.used_formatted }} dari {{ lumina_storage.total_formatted }} digunakan</div>
        </div>

        <ul class="nav-list" style="list-style: none; padding: 0; margin: 0;">
            <li>
                <a href="{{{ config.wwwroot }}}/user/preferences.php" class="nav-link-item">
